# copy to server/.env (loaded by `npm run dev -w server` via --env-file-if-exists)
PORT=8080
HOST=0.0.0.0
# LOG_DIR=./logs
# STATIC_DIR=../client/dist
MAX_ROOMS=50
MAX_PLAYERS_PER_ROOM=8
MAX_PAYLOAD=4096
MSG_RATE=30
MSG_BURST=60
JOIN_TIMEOUT_MS=5000
HEARTBEAT_MS=15000
SLOW_CLIENT_BYTES=262144
# lab 4 demo of a blocking handler; never enable in production
ENABLE_SLOW_ENDPOINT=0
LOG_LEVEL=info
# Lab 8: production limits (validated by zod at startup; secrets go to the platform's secret store, never here)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
MAX_CONNECTIONS=2000
MAX_CONNECTIONS_PER_IP=8
COLLISION=hash
# set by CI/Docker: GIT_SHA=<commit> GIT_TAG=<tag>
